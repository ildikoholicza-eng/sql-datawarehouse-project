SELECT prd_key, count(*) from (
SELECT 

	pn.prd_id,
	pn.prd_key ,
	pn.prd_nm ,
	pn.cat_id ,
	pc.cat,
	pc.subcat ,
	pn.prd_cost ,
	pc. maintenance,
	pn.prd_line, 
	pn.prd_start_dt	
FROM silver.crm_prd_info pn
LEFT JOIN
silver.erp_px_cat_g1v2 pc
ON pn.cat_id = pc.id
WHERE prd_end_dt IS NULL --filter out historical data 
)t GROUP BY prd_key
HAVING COUNT(*) > 1

